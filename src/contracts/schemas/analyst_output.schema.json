{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "metric_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricValue"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "text": {
          "maxLength": 280,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "text",
        "evidence_event_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimKind": {
      "enum": [
        "observation",
        "interpretation"
      ],
      "title": "ClaimKind",
      "type": "string"
    },
    "MetricName": {
      "enum": [
        "passes_attempted",
        "passes_completed",
        "pass_completion",
        "pressures",
        "pressures_opp_half",
        "ball_wins",
        "high_ball_wins",
        "shots",
        "goals"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "definition_version": {
          "const": "metrics-v1",
          "default": "metrics-v1",
          "title": "Definition Version",
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/MetricName"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "count",
            "ratio"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "team_id",
        "value",
        "unit",
        "event_ids"
      ],
      "title": "MetricValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstain": {
      "default": false,
      "title": "Abstain",
      "type": "boolean"
    },
    "abstain_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstain Reason"
    },
    "alternative_explanations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternative Explanations",
      "type": "array"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "snapshot_id",
    "claims"
  ],
  "title": "AnalystOutput",
  "type": "object"
}
