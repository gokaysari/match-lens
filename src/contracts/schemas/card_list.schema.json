{
  "$defs": {
    "Card": {
      "additionalProperties": false,
      "description": "A deterministic template card. Later the agent pipeline produces cards of\nthe same shape; until then text comes only from fixed templates + metrics.",
      "properties": {
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "card_id": {
          "minLength": 1,
          "title": "Card Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "expires_at_ms": {
          "title": "Expires At Ms",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/CardKind"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricValue"
          },
          "title": "Metrics",
          "type": "array"
        },
        "origin": {
          "const": "template",
          "default": "template",
          "title": "Origin",
          "type": "string"
        },
        "template_id": {
          "const": "fact-card",
          "default": "fact-card",
          "title": "Template Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trigger_clock_ms": {
          "title": "Trigger Clock Ms",
          "type": "integer"
        },
        "trigger_seq": {
          "title": "Trigger Seq",
          "type": "integer"
        }
      },
      "required": [
        "card_id",
        "kind",
        "title",
        "body",
        "trigger_seq",
        "trigger_clock_ms",
        "expires_at_ms",
        "metrics",
        "evidence_event_ids"
      ],
      "title": "Card",
      "type": "object"
    },
    "CardKind": {
      "enum": [
        "goal",
        "press_surge"
      ],
      "title": "CardKind",
      "type": "string"
    },
    "MetricName": {
      "enum": [
        "passes_attempted",
        "passes_completed",
        "pass_completion",
        "pressures",
        "ball_wins",
        "high_ball_wins",
        "shots",
        "goals"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "definition_version": {
          "const": "metrics-v1",
          "default": "metrics-v1",
          "title": "Definition Version",
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/MetricName"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "count",
            "ratio"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "team_id",
        "value",
        "unit",
        "event_ids"
      ],
      "title": "MetricValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cards": {
      "items": {
        "$ref": "#/$defs/Card"
      },
      "title": "Cards",
      "type": "array"
    },
    "match_id": {
      "minLength": 1,
      "title": "Match Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "match_id",
    "snapshot_id",
    "cards"
  ],
  "title": "CardList",
  "type": "object"
}
