{
  "$defs": {
    "ClaimKind": {
      "enum": [
        "observation",
        "interpretation"
      ],
      "title": "ClaimKind",
      "type": "string"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "One code-computed value an agent may quote, by key only.",
      "properties": {
        "event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "key": {
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$",
          "title": "Key",
          "type": "string"
        },
        "meaning": {
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "text",
        "meaning"
      ],
      "title": "Fact",
      "type": "object"
    },
    "InsightOutcome": {
      "enum": [
        "published",
        "fallback",
        "abstained"
      ],
      "title": "InsightOutcome",
      "type": "string"
    },
    "Persona": {
      "enum": [
        "analyst",
        "casual"
      ],
      "title": "Persona",
      "type": "string"
    },
    "PersonaText": {
      "additionalProperties": false,
      "description": "In StoryOutput: templates written by the model ({fact_key} placeholders, no\ndigits). In Insight: the same text rendered by code with fact values.",
      "properties": {
        "body": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "language": {
          "const": "en",
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "persona": {
          "$ref": "#/$defs/Persona"
        },
        "title": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "persona",
        "title",
        "body"
      ],
      "title": "PersonaText",
      "type": "object"
    },
    "PublishedClaim": {
      "additionalProperties": false,
      "description": "An approved claim as shown to users: `text` rendered, `template` as reviewed.",
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "fact_keys": {
          "items": {
            "type": "string"
          },
          "title": "Fact Keys",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "template": {
          "minLength": 1,
          "title": "Template",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "text",
        "template",
        "evidence_event_ids",
        "fact_keys"
      ],
      "title": "PublishedClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the UI renders for one moment. Always renderable: on any failure the\nvariants are built from the deterministic source_card.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/PublishedClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "expires_at_ms": {
      "title": "Expires At Ms",
      "type": "integer"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "insight_id": {
      "minLength": 1,
      "title": "Insight Id",
      "type": "string"
    },
    "match_id": {
      "minLength": 1,
      "title": "Match Id",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "outcome": {
      "$ref": "#/$defs/InsightOutcome"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "trigger_clock_ms": {
      "title": "Trigger Clock Ms",
      "type": "integer"
    },
    "trigger_seq": {
      "title": "Trigger Seq",
      "type": "integer"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/PersonaText"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "insight_id",
    "match_id",
    "snapshot_id",
    "trigger_seq",
    "trigger_clock_ms",
    "expires_at_ms",
    "outcome",
    "variants",
    "claims",
    "facts",
    "evidence_event_ids",
    "prompt_version"
  ],
  "title": "Insight",
  "type": "object"
}
